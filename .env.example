# Postgres connection string. Any hosted Postgres works — Railway, Render,
# Supabase, and Neon all have a free/cheap tier and give you this URL
# directly from their dashboard.
DATABASE_URL="postgresql://neondb_owner:npg_TBjG8oV7lpJh@ep-lingering-breeze-ax29x63f.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="1324BVSVCHVABBAfgaffvb78"

# Optional: require this code to register, so strangers who find your URL
# can't create accounts. Leave blank/unset to allow open sign-up.
INVITE_CODE=""

# ---- Photo storage ----
# "local" (default) writes to disk at UPLOAD_DIR — needs a persistent
# volume on your host, or files vanish on redeploy. Fine for a small group.
# "s3" writes to any S3-compatible bucket — recommended once you're
# expecting a lot of photos, since storage scales independently of the
# app server. Cloudflare R2 and Backblaze B2 are cheap options with
# S3-compatible APIs.
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Only needed if STORAGE_DRIVER=s3:
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<account-id>.r2.cloudflarestorage.com — leave blank for real AWS S3
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
